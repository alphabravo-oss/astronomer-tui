{
  "name": "astrotui",
  "slug": "i-want-to-make-a-clone-of-k9s-but-call-it-astronomer-tui-and",
  "description": "A k9s-class Kubernetes TUI in Go intended as a daily-driver replacement, with a global command palette + fuzzy search as the primary navigation model and an optional, configurable multi-provider AI assistant (explain failure, summarize logs, explain manifest, NL-to-action).",
  "started": "2026-05-08",
  "license": "Apache-2.0",
  "module_path": "github.com/alphabravo-oss/astrotui",
  "binary_name": "astrotui",
  "config_dir": "~/.config/astrotui/",
  "foundational_decisions": {
    "language": "Go",
    "tui_library": "tview/tcell",
    "ambition": "daily-driver replacement",
    "multi_cluster": "single active context + fast switcher; data layer architected for future warm-background mode",
    "ai": {
      "default": "off",
      "providers": ["anthropic", "openai", "ollama"],
      "interface": "LLMProvider"
    },
    "headline_ux": "command palette + global fuzzy search (resources, actions, contexts, namespaces, plugins)",
    "safety_model": "read+write enabled; prod-context guard requires typed confirmation when current context matches configurable regex (default (?i)prod|production)",
    "resource_coverage": "full k9s built-in parity + dynamic CRDs",
    "plugins": "drop-in compatible with k9s ~/.config/k9s/plugins.yaml",
    "logs": "multi-pod merged stream with pod-prefix coloring, JSON/logfmt parsing, regex search, jump-to-source, AI-summarize button",
    "config": "astrotui-native schema; one-shot `astrotui config import-k9s` migrates skin/hotkeys/aliases",
    "distribution": ["github-releases-signed-binaries", "container-image-ghcr"],
    "tests": "envtest unit + kind e2e; AI uses MockLLMProvider with opt-in real-call suite",
    "telemetry": "zero",
    "performance": "k9s-class strict (cold start <300ms, render <100ms, idle CPU <2%, memory <150MB)",
    "editing": "shell out to $EDITOR",
    "auth_methods_mvp": ["static-kubeconfig", "exec-plugins"],
    "mvp_cut_line": "big-bang"
  },
  "scope": {
    "in_scope": [
      "Read/list/watch/describe of all k9s built-in resources + dynamic CRDs",
      "Edit ($EDITOR), delete (prod-guard), scale, restart, port-forward, exec",
      "Multi-pod merged log stream, structured-log parsing, regex search, jump-to-source, AI-summarize",
      "Command palette indexing resources/actions/contexts/namespaces/plugins",
      "AI module: explain failure, summarize logs, explain manifest, NL-to-action",
      "k9s plugins.yaml drop-in compatibility",
      "Session restore (last context+ns+filter)",
      "Port-forward manager view",
      "Live `?` keybind discoverability overlay",
      "Theme/skin engine with live reload",
      "Auth: static kubeconfig + exec plugins (aws/gcloud/kubelogin)",
      "`astrotui config import-k9s` migration command"
    ],
    "out_of_scope": [
      "Helm release management",
      "ArgoCD / Flux GitOps integration",
      "Cost / metrics overlay (Prom/OpenCost)",
      "Web UI / hybrid mode",
      "Homebrew tap and Krew distribution (defer to v1.x)",
      "OIDC token refresh and in-cluster service-account auth",
      "Concurrent multi-cluster split-pane UI",
      "In-TUI YAML editor with schema validation",
      "Telemetry of any kind"
    ]
  },

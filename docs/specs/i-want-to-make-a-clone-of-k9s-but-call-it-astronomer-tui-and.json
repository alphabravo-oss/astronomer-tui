  "non_functional_requirements": [
    {"id": "NFR-1", "category": "performance", "requirement": "Cold start <=300ms on 1k-pod cluster"},
    {"id": "NFR-2", "category": "performance", "requirement": "Resource list re-renders <=100ms after watch sync; keystroke->frame <=16ms"},
    {"id": "NFR-3", "category": "performance", "requirement": "Idle CPU <=2% on 1k-pod cluster averaged 60s"},
    {"id": "NFR-4", "category": "performance", "requirement": "RSS <=150MB after 5 min normal use"},
    {"id": "NFR-5", "category": "size", "requirement": "Stripped binary <=30MB per arch"},
    {"id": "NFR-6", "category": "auth", "requirement": "Static kubeconfig + exec plugins (aws/gcloud/kubelogin) work without setup beyond PATH"},
    {"id": "NFR-7", "category": "privacy", "requirement": "Zero telemetry; only outbound calls are apiserver and (when enabled) configured LLM provider"},
    {"id": "NFR-8", "category": "test", "requirement": "Unit coverage >=70% on cluster/actions/logs; kind-based e2e covers golden path of every US"},
    {"id": "NFR-9", "category": "security", "requirement": "Cosign keyless signing via Sigstore; no CGO; container runs as non-root"},
    {"id": "NFR-10", "category": "reliability", "requirement": "Panics in handlers recovered without dropping the TUI"}
  ],
  "open_questions": [
    "Confirm module path 'github.com/alphabravo-oss/astrotui' at repo creation",
    "Default AI model per provider (proposed: Claude Sonnet 4.6 / gpt-4o-mini / llama3.1:8b)",
    "Keybinding scheme: k9s parity vs reimagined (proposed: parity for v1)",
    "Snapshot-test format for tcell screens (ANSI golden vs cell-grid JSON)",
    "Crash-log location (proposed: ~/.local/state/astrotui/crashes/<ts>.log)",
    "Sigstore keyless signing requires GH OIDC; switch to managed key if release moves off GH Actions"
  ]
